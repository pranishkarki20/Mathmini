DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local development defaults to SQLite. Set a PostgreSQL URL to use Postgres.
DATABASE_URL=
DB_SSLMODE=prefer
# Safe for local classroom demonstrations only; set false in a deployed environment.
ALLOW_DEMO_WRITES=true
OSM_AUTO_FETCH=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
TRAFFIC_PROVIDER=simulation
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_USER_AGENT=SmartFlowRoadNetworkPlatform/1.0 (contact: you@example.com)
TOMTOM_API_KEY=
